# Токен бота от @BotFather
BOT_TOKEN=
# Telegram ID администраторов через запятую (свой ID можно узнать у @userinfobot)
ADMIN_IDS=123456789
# Название, которое бот покажет в приветствии
BUSINESS_NAME=Студия «Пример»
TIMEZONE=Europe/Moscow
# Сколько заявок один человек может оставить за сутки (защита от спама)
MAX_LEADS_PER_DAY=3

FAQ_PATH=faq.json
# SQLite по умолчанию. Для PostgreSQL: postgresql+asyncpg://user:pass@host:5432/leads
DATABASE_URL=sqlite+aiosqlite:///data/leads.db
