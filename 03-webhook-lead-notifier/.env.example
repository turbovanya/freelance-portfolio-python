# Секретный ключ: сайт передаёт его в заголовке X-API-Key или параметром ?key=
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Пустой или change-me не подойдёт: сервис не запустится
API_KEY=

# Куда слать заявки: токен бота от @BotFather и ID чата или группы (у группы ID с минусом)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Вход в панель /admin. Без пароля панель отключена
ADMIN_USER=admin
ADMIN_PASSWORD=

# Домены сайта, с которых разрешена отправка формы из браузера, через запятую
ALLOWED_ORIGINS=https://example.ru
# Не больше N заявок в минуту с одного IP
RATE_LIMIT_PER_MINUTE=10
# Как часто пытаться дослать заявки, если Telegram был недоступен, сек
RESEND_INTERVAL_SECONDS=60
TIMEZONE=Europe/Moscow
# Демонстрационная форма на /demo
DEMO_FORM=false

# SQLite по умолчанию. Для PostgreSQL: postgresql+asyncpg://user:pass@host:5432/leads
DATABASE_URL=sqlite+aiosqlite:///data/leads.db
