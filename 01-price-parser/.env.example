# Сколько страниц каталога обходить (0 = все)
MAX_PAGES=3
# Пауза между запросами, сек. Не ставьте 0 на чужих сайтах
REQUEST_DELAY=0.5
REQUEST_TIMEOUT=15
RETRIES=3
# Прокси, если сайт ограничивает запросы: http://user:pass@host:port
PROXY=

OUTPUT_DIR=output
DB_PATH=output/prices.db
PROFILES_DIR=profiles

# Сводка об изменениях в Telegram (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Сообщать только об изменениях больше N процентов
NOTIFY_THRESHOLD_PERCENT=0
