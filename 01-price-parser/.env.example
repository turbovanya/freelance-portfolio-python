# Каталог для парсинга (учебный сайт, парсинг разрешён)
BASE_URL=https://books.toscrape.com/
# Сколько страниц каталога обойти (0 = все)
MAX_PAGES=3
# Пауза между запросами, сек (будьте вежливы к сайту)
REQUEST_DELAY=0.5
# Повторы при сетевых ошибках
RETRIES=3
OUTPUT_DIR=output
DB_PATH=output/prices.db
